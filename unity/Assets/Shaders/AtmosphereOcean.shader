Shader "SunsetPursuit/AtmosphereOcean"
{
    Properties { _MainTex ("Source", 2D) = "white" {} _EarthColor ("Earth colour", 2D) = "white" {} _LandMask ("Land mask", 2D) = "black" {} _CloudVolume ("3D cloud atlas", 2D) = "white" {} }
    SubShader
    {
        Cull Off ZWrite Off ZTest Always
        Pass
        {
            CGPROGRAM
            #pragma vertex vert_img
            #pragma fragment frag
            #pragma target 3.0
            #include "UnityCG.cginc"

            sampler2D _EarthColor, _LandMask, _CloudVolume;
            float4x4 _CameraToWorld;
            float3 _East, _North, _Up, _SunDir;
            float _Radius, _Altitude, _Fov, _Aspect, _Exposure, _CloudCover, _UtcSeconds, _CameraMode;
            float2 _CloudAnchor;
            int _SkySteps, _CloudSteps;
            static const float PI = 3.14159265359;
            static const float3 BETA_R = float3(5.8e-6, 13.5e-6, 33.1e-6);
            static const float3 BETA_M = float3(20e-6, 20e-6, 20e-6);

            float2 roots(float3 origin, float3 ray, float radius)
            {
                float b = dot(origin, ray);
                float c = dot(origin, origin) - radius * radius;
                float d = b*b - c;
                if (d < 0) return float2(-1,-1);
                float s = sqrt(d);
                return float2(-b-s, -b+s);
            }

            float hash(float3 p)
            {
                p = frac(p * 0.1031);
                p += dot(p, p.yzx + 33.33);
                return frac((p.x + p.y) * p.z);
            }

            float noise3(float3 x)
            {
                float3 i = floor(x), f = frac(x);
                f = f*f*(3-2*f);
                return lerp(lerp(lerp(hash(i),hash(i+float3(1,0,0)),f.x),
                                 lerp(hash(i+float3(0,1,0)),hash(i+float3(1,1,0)),f.x),f.y),
                            lerp(lerp(hash(i+float3(0,0,1)),hash(i+float3(1,0,1)),f.x),
                                 lerp(hash(i+float3(0,1,1)),hash(i+1),f.x),f.y),f.z);
            }

            float fbm(float3 p)
            {
                float n = 0.0, amp = 0.55;
                [unroll] for (int i=0; i<4; i++) { n += amp*noise3(p); p *= 2.03; amp *= 0.48; }
                return n;
            }

            // 128-slice, 16x8 atlas generated by the original project's
            // cloud-volume script. Tri-linear interpolation reconstructs a
            // continuous, repeating 3D density field from a 2D texture.
            float2 volumeUV(float2 xy,float slice)
            {
                float2 tile=float2(fmod(slice,16.0),floor(slice/16.0));
                return (tile*130.0+1.5+xy*128.0)/float2(2080.0,1040.0);
            }

            float cloudVolume(float3 p)
            {
                float3 v=frac(p);
                float z=v.z*128.0,z0=floor(z),z1=fmod(z0+1.0,128.0);
                return lerp(tex2D(_CloudVolume,volumeUV(v.xy,z0)).r,
                            tex2D(_CloudVolume,volumeUV(v.xy,z1)).r,frac(z));
            }

            float3 filmic(float3 x)
            {
                x = max(0, x);
                return saturate((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14));
            }

            float3 solarTransmission(float height, float mu)
            {
                float angle = asin(clamp(mu,-1.0,1.0))*57.29578;
                // Near-horizon optical path; below the local horizon only the
                // attenuated twilight contribution remains.
                float airMass = 1.0 / max(0.025, mu + 0.15 * pow(max(1.0, 93.885-angle), -1.253));
                airMass = min(40.0, airMass);
                float r = exp(-max(0,height)/8000.0);
                float m = exp(-max(0,height)/1200.0);
                float twilight = smoothstep(-10.0, -0.5, angle);
                return exp(-(BETA_R*8000.0*r + BETA_M*1200.0*m)*airMass) * (0.045 + 0.955*twilight);
            }

            float3 skyColour(float3 ro, float3 rd, float maxDistance)
            {
                float2 outer = roots(ro, rd, _Radius+100000.0);
                float end = min(maxDistance, outer.y);
                if (end <= 0.0) return 0;
                float stepLength = end / max(1,_SkySteps);
                float opticalR = 0, opticalM = 0;
                float3 result = 0;
                float phaseCos = dot(rd,_SunDir);
                float rayleighPhase = 3.0/(16.0*PI)*(1.0+phaseCos*phaseCos);
                float g = 0.76;
                float miePhase = 3.0/(8.0*PI) * (1.0-g*g)*(1.0+phaseCos*phaseCos)
                    / ((2.0+g*g)*pow(max(0.04,1.0+g*g-2.0*g*phaseCos),1.5));
                [loop] for (int i=0; i<16; i++)
                {
                    if (i>=_SkySteps) break;
                    float3 p = ro + rd*((i+0.5)*stepLength);
                    float h = max(0.0,length(p)-_Radius);
                    float dR = exp(-h/8000.0), dM = exp(-h/1200.0);
                    opticalR += dR*stepLength;
                    opticalM += dM*stepLength;
                    float3 transView = exp(-BETA_R*opticalR - BETA_M*opticalM);
                    float3 transSun = solarTransmission(h, dot(_SunDir,normalize(p)));
                    result += transView*transSun*(BETA_R*dR*rayleighPhase+BETA_M*dM*miePhase)*stepLength;
                }
                return result * 19.0;
            }

            float3 groundColour(float3 hit, float3 rd, float3 sky, float3 sunLight)
            {
                float3 n = normalize(hit);
                float3 ecef = _East*hit.x + _Up*hit.y + _North*hit.z;
                float2 uv = float2(atan2(ecef.y,ecef.x)/(2.0*PI)+0.5, asin(clamp(ecef.z/length(ecef),-1,1))/PI+0.5);
                float land = tex2D(_LandMask,uv).r;
                float3 map = tex2D(_EarthColor,uv).rgb;
                float3 ocean = float3(0.012,0.055,0.09);
                float fresnel = pow(1.0-saturate(dot(n,-rd)),5.0);
                ocean += sky*(0.12+0.55*fresnel);
                float wave = noise3(hit/220.0 + float3(_CloudAnchor.x,0,_CloudAnchor.y)*0.002);
                float3 reflected = reflect(-_SunDir,n);
                float glint = pow(saturate(dot(-rd,reflected)),120.0-70.0*wave);
                ocean += sunLight*glint*(0.25+0.75*wave)*3.0;
                float day = saturate(dot(n,_SunDir)*5.0+0.12);
                float3 terrain = map*(0.12+0.95*day) + sky*0.08;
                float3 ground = lerp(ocean,terrain,smoothstep(0.25,0.75,land));
                float distance = length(hit-float3(0,_Radius+_Altitude,0));
                float haze = 1.0-exp(-distance*exp(-_Altitude/13000.0)/65000.0);
                return lerp(ground,sky,saturate(haze*0.78));
            }

            float cloudDensity(float3 p,float bottom,float top,float cellSize,float seed)
            {
                float h = length(p)-_Radius;
                float normalizedHeight=(h-bottom)/(top-bottom);
                float2 grid=float2(p.x+_CloudAnchor.x,p.z+_CloudAnchor.y)/cellSize;
                float2 baseCell=floor(grid-0.5);
                float mass=0;
                [unroll] for(int cy=0;cy<2;cy++) [unroll] for(int cx=0;cx<2;cx++)
                {
                    float2 cell=baseCell+float2(cx,cy);
                    float random=hash(float3(cell,seed*17.0));
                    float present=1.0-step(_CloudCover,random);
                    float2 jitter=frac(float2(random*17.17,random*37.43))-0.5;
                    float2 center=cell+0.5+jitter*0.34;
                    float radius=0.30+0.09*frac(random*11.73);
                    float2 horizontal=(grid-center)/radius;
                    float reach=seed>7.0?lerp(0.43,0.99,pow(hash(float3(cell,seed*83.0)),2.2)):1.0;
                    float localH=normalizedHeight/reach;
                    float lower=dot(horizontal,horizontal)+pow((localH-0.34)/0.39,2.0);
                    float2 crown=(grid-center-jitter*0.14-float2(0.13,0.10))/max(0.18,radius*0.70);
                    float upper=dot(crown,crown)+pow((localH-(0.66+0.08*frac(random*53.11)))/0.29,2.0);
                    float2 satellite=(grid-center-float2(-0.15,0.07)-jitter*0.11)/max(0.15,radius*0.52);
                    float small=dot(satellite,satellite)+pow((localH-(0.53+0.10*frac(random*71.37)))/0.22,2.0);
                    float puff=max(max(1.0-smoothstep(0.38,1.14,lower),0.94*(1.0-smoothstep(0.34,1.08,upper))),
                                   0.88*(1.0-smoothstep(0.34,1.08,small)));
                    mass=max(mass,present*puff);
                }
                float3 q=float3(p.x+_CloudAnchor.x,h,p.z+_CloudAnchor.y);
                float sculpt=cloudVolume((q+seed*float3(13217,4811,9761))/9500.0);
                float detail=cloudVolume((q+seed*float3(913,7411,2473))/2800.0);
                sculpt=lerp(sculpt,detail,0.34);
                return smoothstep(0.08,0.68,mass*(0.32+1.42*sculpt))
                    *smoothstep(-0.03,0.13,normalizedHeight)*(1.0-smoothstep(0.94,1.02,normalizedHeight));
            }

            float4 cloudLayer(float3 ro,float3 rd,float terrainDistance,float bottom,float top,float cellSize,float seed,int steps)
            {
                float2 outer = roots(ro,rd,_Radius+top);
                float2 inner = roots(ro,rd,_Radius+bottom);
                if (outer.y <= 0.0) return float4(0,0,0,0);
                float begin = max(0.0,outer.x), end = min(outer.y,terrainDistance);
                float r = length(ro);
                if (r < _Radius+bottom) begin = max(begin,inner.y);
                else if (inner.x > begin && inner.x < end) end = inner.x;
                end = min(end,begin+36000.0);
                if (end <= begin) return float4(0,0,0,0);
                float stepLength = (end-begin)/steps;
                float4 accum = 0;
                [loop] for (int i=0;i<24;i++)
                {
                    if (i>=steps) break;
                    float t = begin+(i+0.55)*stepLength;
                    float3 p = ro+rd*t;
                    float d = cloudDensity(p,bottom,top,cellSize,seed);
                    if (d < 0.003) continue;
                    float3 n = normalize(p);
                    float light = saturate(dot(_SunDir,n)*3.0+0.35);
                    float side = saturate(dot(_SunDir,-rd)*0.5+0.5);
                    float3 warm = solarTransmission(length(p)-_Radius,dot(_SunDir,n));
                    float localH=(length(p)-_Radius-bottom)/(top-bottom);
                    float topLight=smoothstep(0.12,0.8,localH)*light;
                    float3 c = lerp(float3(0.16,0.19,0.23),float3(0.65,0.72,0.78),topLight);
                    c += warm*(0.13+0.50*side)*(0.3+0.7*topLight);
                    float a = 1.0-exp(-d*stepLength/(seed>7.0?3500.0:2200.0));
                    a *= (1.0-accum.a);
                    accum.rgb += c*a;
                    accum.a += a;
                    if (accum.a > 0.98) break;
                }
                return accum;
            }

            float4 cloudColour(float3 ro,float3 rd,float terrainDistance)
            {
                if (_CloudCover < 0.02 || _CloudSteps < 1) return float4(0,0,0,0);
                float4 low=cloudLayer(ro,rd,terrainDistance,900.0,3200.0,11500.0,5.1,_CloudSteps);
                float4 middle=cloudLayer(ro,rd,terrainDistance,2800.0,12000.0,18500.0,8.3,max(3,_CloudSteps/2));
                float4 combined;
                if (_Altitude > 3200.0)
                    combined=float4(middle.rgb+low.rgb*(1.0-middle.a),middle.a+low.a*(1.0-middle.a));
                else
                    combined=float4(low.rgb+middle.rgb*(1.0-low.a),low.a+middle.a*(1.0-low.a));
                // High cirrus is deliberately thin: it adds twilight structure
                // without turning the upper atmosphere into a white ceiling.
                float2 high=roots(ro,rd,_Radius+8500.0);
                float t=high.x>0?high.x:high.y;
                if (t>0 && t<terrainDistance)
                {
                    float3 p=ro+rd*t;
                    float3 q=float3(p.x+_CloudAnchor.x,8500.0,p.z+_CloudAnchor.y);
                    float wisps=cloudVolume((q+float3(24801,9127,4183))/30000.0);
                    float thin=smoothstep(lerp(0.85,0.43,_CloudCover),0.95,wisps)*0.10;
                    float3 tint=lerp(float3(0.18,0.23,0.32),float3(0.70,0.72,0.69),saturate(_SunDir.y*5.0+0.7));
                    combined.rgb=combined.rgb+tint*thin*(1.0-combined.a);
                    combined.a+=thin*(1.0-combined.a);
                }
                return combined;
            }

            fixed4 frag(v2f_img input) : SV_Target
            {
                float2 ndc = input.uv*2.0-1.0;
                float tanHalf = tan(_Fov*0.5*PI/180.0);
                float3 local = normalize(float3(ndc.x*tanHalf*_Aspect,ndc.y*tanHalf,1.0));
                float3 rd = normalize(mul((float3x3)_CameraToWorld,local));
                float3 ro = float3(0,_Radius+_Altitude,0);
                float2 earth = roots(ro,rd,_Radius);
                float earthT = earth.x > 0.0 ? earth.x : 1e9;
                float3 sky = skyColour(ro,rd,earthT);
                float3 sunTrans = solarTransmission(_Altitude,dot(_SunDir,normalize(ro)));
                if (earthT < 1e8)
                    sky = groundColour(ro+rd*earthT,rd,sky,sunTrans);
                float sunAngle = acos(clamp(dot(rd,_SunDir),-1,1));
                float sunRadius = 0.2666*PI/180.0;
                if (earthT > 1e8)
                {
                    float disc = 1.0-smoothstep(sunRadius-0.00008,sunRadius+0.00008,sunAngle);
                    float halo = exp(-sunAngle*sunAngle/(0.018*0.018))*0.13;
                    sky += sunTrans*(disc*28.0+halo);
                }
                float4 cloud = cloudColour(ro,rd,earthT);
                sky = sky*(1.0-cloud.a)+cloud.rgb;
                // Dither before output encoding to keep low-saturation twilight smooth.
                float dither = hash(float3(input.uv*_ScreenParams.xy,frac(_UtcSeconds*0.1)))-0.5;
                float3 colour = filmic(sky*_Exposure*(1.0+0.12*_CameraMode));
                return float4(saturate(colour+dither/512.0),1.0);
            }
            ENDCG
        }
    }
    Fallback Off
}
